---
// SiteLayout — shared shell with header, main, and footer.
// Establishes the metadata mechanism (title/description/canonical).
// Full SEO optimization (OG, structured data, sitemap) lands in Phase 7.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, site } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  currentPath?: string;
}

const {
  title = site.name,
  description = site.description,
  lang = 'id',
  currentPath = Astro.url.pathname,
} = Astro.props;

// Canonical URL resolves against the `site` value in astro.config.mjs.
const SITE = import.meta.env.SITE;
const resolvedCanonical = SITE
  ? new URL(Astro.url.pathname, SITE).href
  : undefined;

const htmlTitle = title === site.name ? title : `${title} — ${company.shortName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{htmlTitle}</title>
    <meta name="description" content={description} />
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>