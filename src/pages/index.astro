---
// Home — corporate landing page.
// Structural flow (approved): Hero → Company Intro → Capabilities →
// Industries → Solutions → Gerbang Edukasi feature → Experience → Strengths → CTA.
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { company, site } from '../data/company';
import { services } from '../data/services';
import { industries } from '../data/industries';
import { solutions, gerbangEdukasiProductLabel } from '../data/solutions';
import { projectCount } from '../data/experience';
---

<SiteLayout
  title={site.name}
  description={site.description}
  currentPath="/"
>
  {/* 01 — Hero */}
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__kicker">{company.name}</p>
      <h1 class="hero__title">{company.tagline}</h1>
      <p class="hero__sub">
        A technology consulting and solutions company with experience across
        education, government, and business sectors.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/solutions">Explore Our Solutions</a>
        <a class="btn btn--outline" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>

  {/* 02 — Company Introduction */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="About GCS"
        title={`Established in ${company.founded}`}
        lead="GCS is a technology consulting company providing services related to Information Technology — planning, implementation, training, supervision, software, and hardware."
      />
      <p>
        Since 2012, GCS has worked with experienced professionals on projects
        across government and private sectors, as well as in education.
      </p>
      <a class="btn btn--dark" href="/about">Learn About GCS</a>
    </div>
  </section>

  {/* 03 — Core Capabilities */}
  <section class="section section--soft">
    <div class="container">
      <SectionHeader
        eyebrow="What We Do"
        title="Core Capabilities"
        lead="Six major capability areas rooted in GCS's technology consulting scope."
      />
      <div class="grid">
        {
          services.map((s) => (
            <article class="card" key={s.id}>
              <h3>{s.name}</h3>
              <p>{s.shortDescription}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 04 — Industries */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Who We Serve"
        title="Industries"
        lead="Sectors GCS serves through technology consulting and solutions."
      />
      <div class="grid grid--compact">
        {
          industries.map((i) => (
            <article class="card" key={i.id}>
              <h3>{i.name}</h3>
              <p>{i.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 05 — Solutions */}
  <section class="section section--soft">
    <div class="container">
      <SectionHeader
        eyebrow="Products & Solutions"
        title="Solutions"
        lead="Information systems, education solutions, interactive multimedia, and more."
      />
      <div class="grid">
        {
          solutions.map((s) => (
            <article class="card" key={s.id}>
              <h3>{s.name}</h3>
              {s.product && <p class="pill">{gerbangEdukasiProductLabel}</p>}
              <p>{s.description}</p>
              <a class="card__link" href={s.route}>View</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 06 — Gerbang Edukasi Feature */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow={gerbangEdukasiProductLabel}
        title="Gerbang Edukasi"
        lead="Interactive learning media for modern education."
      />
      <p class="feature-note">
        Gerbang Edukasi is an interactive learning solution developed by
        PT. Gerbang Cipta Sarana for education and interactive flat panels.
      </p>
      <a class="btn btn--primary" href="/gerbang-edukasi">Explore Gerbang Edukasi</a>
    </div>
  </section>
{/* 07 — Experience */}
  <section class="section section--soft">
    <div class="container">
      <SectionHeader
        eyebrow="Track Record"
        title={`${projectCount}+ Project Experiences`}
        lead="Across government, higher education, schools, and the private sector."
      />
      <a class="btn btn--dark" href="/experience">View Our Experience</a>
    </div>
  </section>

  {/* 08 — Company Strengths */}
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Why GCS" title="Company Strengths" />
      <div class="grid grid--compact">
        <article class="card">
          <h3>Human Resources</h3>
          <p>Quality and professional expertise across technology fields.</p>
        </article>
        <article class="card">
          <h3>Methodology</h3>
          <p>GIP — Gerbang Implementation Methodology combining efficiency, effectiveness, and business considerations.</p>
        </article>
        <article class="card">
          <h3>Directors</h3>
          <p>Direct involvement in project management, concept development, and knowledge transfer.</p>
        </article>
      </div>
    </div>
  </section>

  {/* 09 — CTA */}
  <section class="section cta">
    <div class="container">
      <h2>Let's discuss your technology needs.</h2>
      <a class="btn btn--primary" href="/contact">Contact GCS</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-2) 100%);
    color: #fff;
    padding-block: var(--space-6);
  }

  .hero__inner { max-width: var(--container-narrow); }

  .hero__kicker {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #bcd0e4;
    margin-bottom: var(--space-2);
  }

  .hero__title { color: #fff; }

  .hero__sub { font-size: 1.15rem; color: #d5e0ea; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .grid--compact { grid-template-columns: repeat(3, 1fr); }

  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }

  .pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-teal);
    background: rgba(20, 145, 155, 0.12);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: var(--space-1);
  }

  .card__link { font-weight: 600; }
  .feature-note { margin-bottom: var(--space-2); }

  .cta { background: var(--color-bg-soft); text-align: center; }

  @media (max-width: 820px) {
    .grid, .grid--compact { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .grid, .grid--compact { grid-template-columns: 1fr; }
  }
</style>