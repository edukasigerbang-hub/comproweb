---
// Home — flagship corporate homepage of PT. Gerbang Cipta Sarana.
// Narrative: Hero → Who is GCS → Capabilities → Industries → Solutions →
// Gerbang Edukasi → Why GCS → Final CTA.
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import SolutionCard from '../components/SolutionCard.astro';
import heroGcs from '../assets/hero-gcs.png';
import geClassroom from '../assets/storytelling-gcs.png';
import { company } from '../data/company';
import { services } from '../data/services';
import { industries } from '../data/industries';
import {
  solutions,
  gerbangEdukasiProductLabel,
  GERBANG_EDUKASI_URL,
} from '../data/solutions';
import { lp, type Lang } from '../i18n/config';

interface Props {
  lang?: Lang;
}
const { lang = 'id' } = Astro.props;
const en = lang === 'id' ? false : true;

const hasExternalGeUrl = GERBANG_EDUKASI_URL !== '[TO BE PROVIDED]';
const geHref = hasExternalGeUrl ? GERBANG_EDUKASI_URL : lp(lang, '/gerbang-edukasi');

const t = en
  ? {
      metaTitle: 'PT. Gerbang Cipta Sarana | Technology. Experience. Solutions.',
      metaDesc: 'GCS is an Indonesian technology consulting and solutions company since 2012 — serving government, education, and private-sector organizations.',
      heroLead: 'A technology consulting and solutions company with experience across education, government, and business sectors.',
      exploreSolutions: 'Explore Our Solutions',
      contactUs: 'Contact Us',
      sectors: 'GOVERNMENT · EDUCATION · BUSINESS',
      whoEyebrow: 'Who We Are',
      whoTitle: `Technology consulting since ${company.founded}.`,
      whoP1: 'PT. Gerbang Cipta Sarana (GCS) is a multidisciplinary technology consulting company providing Information Technology services — from planning, implementation, and training to supervision of software and hardware.',
      whoP2: 'Founded by experienced IT professionals, GCS has contributed to development in Indonesia across both the government and private sectors, supported by professional personnel with broad work experience.',
      learnAbout: 'Learn About GCS',
      established: 'Established',
      capEyebrow: 'What We Do',
      capTitle: 'Core Capabilities',
      capLead: 'Six capability areas covering the full lifecycle of technology — from planning and development to training and educational media.',
      indEyebrow: 'Who We Serve',
      indTitle: 'Industries We Serve',
                  indLead: "GCS develops technology solutions according to each organization's needs — across very different environments.",
      solEyebrow: 'Products & Solutions',
      solTitle: 'Solutions',
      solLead: 'Technology capabilities delivered as solutions for organizational needs.',
      geLead: 'Interactive learning media for modern education.',
      geText: `Developed within GCS's interactive multimedia and educational media\n          capabilities, Gerbang Edukasi brings interactive learning to\n          classrooms and Interactive Flat Panel platforms.`,
      geExplore: 'Explore Gerbang Edukasi',
      geDetails: 'Product Details',
      whyEyebrow: 'Why GCS',
      whyTitle: 'The GCS Approach',
      whyLead: 'Three pillars behind the quality and consistency of our work.',
      strPeople: 'People',
      strPeopleDesc: 'Professional human resources with expertise in their respective fields — the foundation of reliable service delivery.',
      strMethodology: 'Methodology',
      strMethodologyDesc: 'GIP — Gerbang Implementation Methodology — combining work efficiency, effectiveness, organizational considerations, and business and management aspects.',
      strInvolvement: 'Involvement',
      strInvolvementDesc: 'Professional involvement across planning, implementation, knowledge transfer, and solution delivery — close engagement that adds value for clients.',
      ctaTitle: 'Let\'s Build the Right Solution',
      ctaText: `Discuss your organization's technology needs with a team that has been delivering solutions since ${company.founded}.`,
      ctaContact: 'Contact Us',
      ctaExplore: 'Explore Solutions',
    }
  : {
      metaTitle: 'PT. Gerbang Cipta Sarana | Teknologi. Pengalaman. Solusi.',
      metaDesc: 'GCS adalah perusahaan konsultan teknologi & solusi Indonesia sejak 2012 — melayani institusi pemerintah, pendidikan, dan sektor swasta.',
      heroLead: 'Perusahaan konsultan teknologi dan solusi dengan pengalaman lintas sektor pendidikan, pemerintahan, dan bisnis.',
      exploreSolutions: 'Jelajahi Solusi Kami',
      contactUs: 'Hubungi Kami',
      sectors: 'PEMERINTAHAN · PENDIDIKAN · BISNIS',
      whoEyebrow: 'Tentang Kami',
      whoTitle: `Konsultan teknologi sejak ${company.founded}.`,
      whoP1: 'PT. Gerbang Cipta Sarana (GCS) adalah perusahaan konsultan teknologi multidisiplin yang menyediakan layanan Teknologi Informasi — mulai dari perencanaan, implementasi, dan pelatihan hingga pengawasan perangkat lunak dan perangkat keras.',
      whoP2: 'Didirikan oleh profesional TI berpengalaman, GCS telah berkontribusi dalam pembangunan Indonesia di sektor pemerintah maupun swasta, didukung tenaga profesional dengan pengalaman kerja yang luas.',
      learnAbout: 'Kenali GCS',
      established: 'Berdiri',
      capEyebrow: 'Apa yang Kami Kerjakan',
      capTitle: 'Kapabilitas Utama',
      capLead: 'Enam area kapabilitas yang mencakup siklus teknologi secara utuh — dari perencanaan dan pengembangan hingga pelatihan dan media pendidikan.',
      indEyebrow: 'Yang Kami Layani',
      indTitle: 'Industri yang Kami Layani',
      indLead: 'GCS mengembangkan solusi teknologi sesuai kebutuhan tiap organisasi — di lingkungan yang sangat beragam.',
      solEyebrow: 'Produk & Solusi',
      solTitle: 'Solusi',
      solLead: 'Kemampuan teknologi yang disampaikan sebagai solusi untuk kebutuhan organisasi.',
      geLead: 'Media pembelajaran interaktif untuk pendidikan modern.',
      geText: `Dikembangkan dari kemampuan multimedia interaktif dan media\n          pendidikan GCS, Gerbang Edukasi membawa pembelajaran interaktif ke\n          kelas dan platform Interactive Flat Panel.`,
      geExplore: 'Jelajahi Gerbang Edukasi',
      geDetails: 'Detail Produk',
      whyEyebrow: 'Mengapa GCS',
      whyTitle: 'Pendekatan GCS',
      whyLead: 'Tiga pilar yang mendukung kualitas dan konsistensi kerja kami.',
      strPeople: 'SDM',
      strPeopleDesc: 'Sumber daya manusia profesional dengan keahlian di bidang masing-masing — fondasi dari layanan yang dapat diandalkan.',
      strMethodology: 'Metodologi',
      strMethodologyDesc: 'GIP — Gerbang Implementation Methodology — menggabungkan efisiensi kerja, keefektifan, pertimbangan organisasi, serta aspek bisnis dan manajemen.',
      strInvolvement: 'Keterlibatan',
      strInvolvementDesc: 'Keterlibatan profesional lintas perencanaan, implementasi, transfer pengetahuan, dan penyampaian solusi — kedekatan yang memberi nilai tambah bagi klien.',
      ctaTitle: 'Mari Bangun Solusi yang Tepat',
      ctaText: `Diskusikan kebutuhan teknologi organisasi Anda dengan tim yang telah\n          mengirimkan solusi sejak ${company.founded}.`,
      ctaContact: 'Hubungi Kami',
      ctaExplore: 'Jelajahi Solusi',
    };
---

<SiteLayout
  title={t.metaTitle}
  description={t.metaDesc}
  currentPath={lp(lang, '/')}
  lang={lang}
>
  {/* 01 — HERO */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid container">
      <div class="hero__content">
        <p class="hero__eyebrow">{company.name}</p>
        <h1 id="hero-title" class="hero__title">
          {en ? 'Technology.' : 'Teknologi.'}<br />
          {en ? 'Experience.' : 'Pengalaman.'}<br />
          {en ? 'Solutions.' : 'Solusi.'}
        </h1>
        <p class="hero__lead">{t.heroLead}</p>
        <div class="hero__actions">
          <Button variant="primary" href={lp(lang, '/solutions')}>{t.exploreSolutions}</Button>
          <Button variant="white" href={lp(lang, '/contact')}>{t.contactUs}</Button>
        </div>
      </div>

      {/* GCS corporate ecosystem visual */}
      <div class="hero__visual">
        <Image
          src={heroGcs}
          alt={en
              ? 'Visualization of the GCS technology ecosystem — interconnected systems serving education, government, health, and industry'
              : 'Visualisasi ekosistem teknologi GCS — sistem yang saling terhubung untuk pendidikan, pemerintahan, kesehatan, dan industri'}
          widths={[480, 720, 960]}
          sizes="(max-width: 820px) 92vw, 44vw"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
        <p class="hero__visual-meta">
          <span>EST. {company.founded}</span>
          <span>{t.sectors}</span>
        </p>
      </div>
    </div>
  </section>

  {/* 02 — WHO IS GCS */}
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container grid grid--feature">
      <div>
        <p class="eyebrow">{t.whoEyebrow}</p>
        <h2 id="intro-title">{t.whoTitle}</h2>
        <p class="intro__text">{t.whoP1}</p>
        <p class="intro__text">{t.whoP2}</p>
        <Button variant="navy" href={lp(lang, '/about')}>{t.learnAbout}</Button>
      </div>
      <div class="intro__visual" aria-hidden="true">
        <span class="intro__year">{company.founded}</span>
        <span class="intro__est">{t.established}</span>
      </div>
    </div>
  </section>
  {/* 03 — CORE CAPABILITIES */}
  <section class="section section--soft" aria-labelledby="cap-title">
    <div class="container">
            <SectionHeader
        eyebrow={t.capEyebrow}
        title={t.capTitle}
        lead={t.capLead}
      />
      <div class="caps">
        {services.map((s, i) => (
          <a
            href={lp(lang, '/services')}
            class={'cap cap--' + (i < 2 ? 'wide' : 'std')}
          >
            <span class="cap__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="cap__body">
              <h3 class="cap__title">{en && s.nameEn ? s.nameEn : s.name}</h3>
              <p class="cap__desc">{en && s.shortDescriptionEn ? s.shortDescriptionEn : s.shortDescription}</p>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 04 — INDUSTRIES */}
  <section class="section" aria-labelledby="ind-title">
    <div class="container">
            <SectionHeader
        eyebrow={t.indEyebrow}
        title={t.indTitle}
        lead={t.indLead}
        align="center"
      />
      <div class="inds">
        {industries.map((ind, i) => (
          <a
            href={lp(lang, '/industries')}
            class={'ind ind--' + (i === 0 ? 'lead' : 'cell')}
          >
            <span class="ind__icon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="ind__name">{en && ind.nameEn ? ind.nameEn : ind.name}</h3>
            <p class="ind__desc">{en && ind.descriptionEn ? ind.descriptionEn : ind.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 05 — SOLUTIONS */}
  <section class="section section--soft" aria-labelledby="sol-title">
    <div class="container">
            <SectionHeader
                eyebrow={t.solEyebrow}
        title={t.solTitle}
        lead={t.solLead}
        cta={{ label: en ? 'All Solutions' : 'Semua Solusi', href: lp(lang, '/solutions') }}
      />
      <div class="sols">
        {solutions.map((sol) => (
          <SolutionCard
            title={en && sol.nameEn ? sol.nameEn : sol.name}
            description={en && sol.descriptionEn ? sol.descriptionEn : sol.description}
            productLabel={sol.product ? gerbangEdukasiProductLabel : undefined}
            accent={sol.product}
            href={lp(lang, sol.route)}
            linkLabel={sol.product ? t.geExplore : (en ? 'View details' : 'Lihat detail')}
          />
        ))}
      </div>
    </div>
  </section>
  {/* 06 — GERBANG EDUKASI FEATURE */}
  <section class="section ge" aria-labelledby="ge-title">
    <div class="container grid grid--feature">
      <div class="ge__content">
        <p class="badge badge--orange">{gerbangEdukasiProductLabel}</p>
                <h2 id="ge-title" class="ge__title">Gerbang Edukasi</h2>
        <p class="ge__lead">{t.geLead}</p>
        <p class="ge__text">{t.geText}</p>
        <div class="ge__actions">
          <Button variant="accent" href={geHref}>{t.geExplore}</Button>
          {hasExternalGeUrl && (
            <Button variant="ghost" href={lp(lang, '/gerbang-edukasi')}>{t.geDetails}</Button>
          )}
        </div>
      </div>

      {/* Product visual — approved classroom asset */}
      <div class="ge__visual">
        <Image
          src={geClassroom}
          alt={en
              ? 'Modern classroom with a teacher and elementary school students using Gerbang Edukasi interactive learning media'
              : 'Kelas modern dengan guru dan siswa sekolah dasar menggunakan media pembelajaran interaktif Gerbang Edukasi'}
          widths={[480, 720, 960]}
          sizes="(max-width: 820px) 92vw, 44vw"
          loading="lazy"
          class="ge__img"
        />
      </div>
    </div>
  </section>

  {/* 07 — WHY GCS / STRENGTHS */}
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <SectionHeader
        eyebrow={t.whyEyebrow}
        title={t.whyTitle}
        lead={t.whyLead}
      />
      <div class="strengths">
        <article class="strength">
          <span class="strength__num">01</span>
          <h3>{t.strPeople}</h3>
          <p>{t.strPeopleDesc}</p>
        </article>
        <article class="strength">
          <span class="strength__num">02</span>
          <h3>{t.strMethodology}</h3>
          <p>{t.strMethodologyDesc}</p>
        </article>
        <article class="strength">
          <span class="strength__num">03</span>
          <h3>{t.strInvolvement}</h3>
          <p>{t.strInvolvementDesc}</p>
        </article>
      </div>
    </div>
  </section>

  {/* 08 — FINAL CTA */}
  <section class="cta" aria-labelledby="cta-title">
    <div class="container cta__inner">
      <h2 id="cta-title">{t.ctaTitle}</h2>
      <p>{t.ctaText}</p>
      <div class="cta__actions">
        <Button variant="primary" href={lp(lang, '/contact')}>{t.ctaContact}</Button>
        <Button variant="white" href={lp(lang, '/solutions')}>{t.ctaExplore}</Button>
      </div>
    </div>
  </section>
</SiteLayout>
<style>
  /* ============ 01 HERO ============ */
  .hero {
    background:
      radial-gradient(circle at 88% 10%, rgba(20, 145, 155, 0.22) 0%, transparent 45%),
      linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-3) 100%);
    color: #fff;
    padding: var(--space-6) 0;
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--font-eyebrow);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8fd0d6;
    margin-bottom: var(--space-3);
  }
  .hero__title {
    color: #fff;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    margin-bottom: var(--space-3);
  }
  .hero__lead { color: #d5e0ea; font-size: var(--font-body-lg); max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }

  /* Hero visual — corporate asset */
  .hero__visual {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: var(--shadow-lg);
    background: rgba(11, 34, 57, 0.4);
  }
  .hero__img { width: 100%; height: auto; display: block; }
  .hero__visual-meta {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--font-caption);
    letter-spacing: 0.12em;
    color: #8fa6bd;
    background: rgba(11, 34, 57, 0.65);
  }

  /* ============ 02 INTRO ============ */
  .intro__text { max-width: 58ch; }
  .intro__visual {
    justify-self: center;
    text-align: center;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    min-width: 260px;
  }
  .intro__year {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 1;
    color: var(--color-navy);
  }
  .intro__est {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: var(--font-caption);
    color: var(--color-teal);
    font-weight: 700;
  }

  /* ============ 03 CAPABILITIES ============ */
  .caps { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .cap {
    display: flex;
    gap: var(--space-2);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    transition: border-color var(--transition-base), transform var(--transition-fast), box-shadow var(--transition-base);
  }
  .cap:hover {
    text-decoration: none;
    border-color: var(--color-blue);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .cap:hover .cap__num { color: var(--color-orange); }
  .cap__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--font-caption);
    color: var(--neutral-300);
    line-height: 1.4;
    transition: color var(--transition-base);
  }
  .cap__title { font-size: var(--font-h4); margin-bottom: 0.35rem; }
  .cap__desc { color: var(--color-muted); margin: 0; font-size: var(--font-body-sm); }

  /* ============ 04 INDUSTRIES ============ */
  .inds {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-inline: auto;
  }
  .ind--lead { grid-column: span 4; flex-direction: row; align-items: center; gap: var(--space-3); }
  .ind {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-fast);
  }
  .ind--lead { border-left: 4px solid var(--color-teal); }
  .ind:hover { text-decoration: none; border-color: var(--color-teal); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .ind__icon { font-family: var(--font-heading); font-weight: 800; font-size: var(--font-caption); color: var(--color-teal); }
  .ind__name { font-size: var(--font-h4); margin: 0; }
  .ind__desc { color: var(--color-muted); margin: 0; font-size: var(--font-body-sm); }

  /* ============ 05 SOLUTIONS ============ */
  .sols { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
</style>
<style>
  /* ============ 06 GERBANG EDUKASI ============ */
  .ge {
    background:
      radial-gradient(circle at 10% 90%, rgba(240, 122, 46, 0.08) 0%, transparent 40%),
      var(--color-bg);
  }
  .ge__title { font-size: var(--font-h1); }
  .ge__lead { font-size: var(--font-h3); color: var(--color-navy); font-weight: 600; }
  .ge__text { max-width: 52ch; }
  .ge__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .ge__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  /* ============ 07 STRENGTHS ============ */
  .strengths { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .strength { border-top: 3px solid var(--color-navy); padding-top: var(--space-3); }
  .strength__num {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--font-h2);
    color: var(--neutral-200);
    line-height: 1;
    margin-bottom: var(--space-2);
  }
  .strength h3 { font-size: var(--font-h3); }
  .strength p { color: var(--color-muted); margin: 0; }

  /* ============ 08 FINAL CTA ============ */
  .cta {
    background:
      radial-gradient(circle at 85% 20%, rgba(20, 145, 155, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-3) 100%);
    color: #fff;
    padding: var(--space-6) 0;
    text-align: center;
  }
  .cta__inner { max-width: var(--container-narrow); }
  .cta h2 { color: #fff; font-size: var(--font-h1); margin-bottom: var(--space-2); }
  .cta p { color: #c9d6e3; font-size: var(--font-body-lg); }
  .cta__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1024px) {
    .sols { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 820px) {
    .hero__grid.hero__grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .hero__visual.hero__visual { order: 2; max-width: 480px; margin-inline: auto; }
    .intro__visual { min-width: 0; padding: var(--space-5); }
    .inds.inds { grid-template-columns: repeat(2, 1fr); }
    .ind--lead.ind--lead { grid-column: span 2; }
  }

  @media (max-width: 560px) {
    .caps.caps { grid-template-columns: 1fr; }
    .inds.inds { grid-template-columns: 1fr; }
    .ind--lead.ind--lead { grid-column: span 1; flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .sols.sols { grid-template-columns: 1fr; }
    .strengths.strengths { grid-template-columns: 1fr; }
    .hero__actions .btn, .cta__actions .btn { width: 100%; }
  }
</style>