---
// Industries — sectors GCS serves.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { industries } from '../data/industries';
---
<SiteLayout
  title="Industries"
  description="Sectors served by GCS: Education, Government, Health, Industry, and Cooperatives / Small Business."
  currentPath="/industries"
>
  <PageHero
    title="Industries"
    subtitle="GCS develops technology solutions according to each organization's needs."
    breadcrumb="Industries"
  />

  <div class="container">
    <section class="section">
      <SectionHeader
        eyebrow="Who We Serve"
        title="Sectors & Industries"
        lead="GCS's technology consulting and solutions span the following sectors."
      />
      <div class="grid">
        {
          industries.map((i) => (
            <article class="card" key={i.id}>
              <span class="card__icon" aria-hidden="true">{i.icon}</span>
              <h2 class="card__title">{i.name}</h2>
              <p class="card__body">{i.description}</p>
            </article>
          ))
        }
      </div>
      <div class="industry-detail">
        <h2>How GCS Works With Each Sector</h2>
        <div class="detail-grid">
          <article>
            <h3>Education</h3>
            <p>Higher education institutions (perguruan tinggi) and schools — including education management systems.</p>
          </article>
          <article>
            <h3>Government</h3>
            <p>Central government, regional government (Pemda/Dinas), and e-government initiatives.</p>
          </article>
          <article>
            <h3>Health</h3>
            <p>Technology solutions supporting public and institutional health services.</p>
          </article>
          <article>
            <h3>Industry</h3>
            <p>Procurement, production, sales, HRD, assets, and finance operations.</p>
          </article>
          <article>
            <h3>Cooperatives / Small Business</h3>
            <p>Solutions tailored for cooperatives, small businesses, and BKK.</p>
          </article>
        </div>
      </div>
      <a class="btn btn--primary" href="/contact">Discuss Your Sector's Needs</a>
    </section>
  </div>
</SiteLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }
  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(20, 145, 155, 0.12);
    color: var(--color-teal);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .card__title { font-size: 1.2rem; margin-bottom: var(--space-1); }
  .card__body { color: var(--color-muted); margin: 0; }

  .industry-detail { margin-top: var(--space-5); }
  .industry-detail h2 { margin-bottom: var(--space-2); }
  .detail-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-bottom: var(--space-3); }
  .detail-grid h3 { font-size: 1.05rem; }
  .detail-grid p { color: var(--color-muted); }

  @media (max-width: 820px) { .grid, .detail-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid, .detail-grid { grid-template-columns: 1fr; } }
</style>