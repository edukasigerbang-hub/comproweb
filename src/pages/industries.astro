---
// Industries — sector landscape: how GCS adapts to different institutional contexts.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { industries } from '../data/industries';

const sectorContexts: Record<string, string> = {
  education:
    'From perguruan tinggi to schools, GCS delivers education management and learning technology adapted to academic workflows.',
  government:
    'Working with central and regional institutions on e-government systems — including regional financial information systems.',
  health:
    'Technology solutions supporting institutional and public health services.',
  industry:
    'Enterprise operations across procurement, production, sales, HRD, assets, and finance.',
  cooperatives:
    'Practical solutions scaled for cooperatives, small businesses, and BKK.',
};

import { lp, type Lang } from '../i18n/config';
interface Props { lang?: Lang }
const { lang = 'id' } = Astro.props;
---
<SiteLayout
  title="Industries We Serve | PT. Gerbang Cipta Sarana"
  description="GCS serves Education, Government, Health, Industry, and Cooperatives/Small Business sectors — adapting technology solutions to each organizational context."
  lang={lang}
  currentPath={lp(lang, '/industries')}
>
  <PageHero
    eyebrow="Industries"
    title="Solutions for Every Institutional Context"
    subtitle="The same capability system, applied differently across very different environments."
    breadcrumb="Industries"
  />

  {/* Lead sector */}
  <section class="section" aria-labelledby="lead-sector">
    <div class="container">
      {industries.slice(0, 1).map((lead) => (
        <article class="sector sector--lead" id={lead.id}>
          <span class="sector__num" aria-hidden="true">01</span>
          <div class="sector__body">
            <h2 id="lead-sector" class="sector__title">{lead.name}</h2>
            <p class="sector__context">{sectorContexts[lead.id]}</p>
            <ul class="sector__points">
              <li>Perguruan Tinggi (higher education)</li>
              <li>Sekolah (schools)</li>
            </ul>
          </div>
        </article>
      ))}

      {/* Secondary sectors */}
      <div class="sector-grid">
        {industries.slice(1).map((ind, i) => (
          <article class="sector" id={ind.id}>
            <span class="sector__num" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
            <h3 class="sector__title sector__title--sm">{ind.name}</h3>
            <p class="sector__context">{sectorContexts[ind.id] ?? ind.description}</p>
          </article>
        ))}
      </div>

      <div class="ind-cta">
        <Button variant="navy" href={lp(lang, '/solutions')}>See Our Solutions</Button>
        <Button variant="ghost" href={lp(lang, '/contact')}>Discuss Your Sector</Button>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .sector {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    position: relative;
  }
  .sector--lead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    border-left: 4px solid var(--color-teal);
    box-shadow: var(--shadow-sm);
  }
  .sector__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-teal);
  }
  .sector--lead .sector__num { font-size: 1.6rem; line-height: 1.3; }
  .sector__title { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: var(--space-2); }
  .sector__title--sm { font-size: var(--font-h4); margin-bottom: 0.5rem; }
  .sector__context { color: var(--color-muted); max-width: 62ch; margin: 0 0 var(--space-3); }
  .sector__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .sector__points li {
    font-size: var(--font-body-sm);
    font-weight: 600;
    color: var(--color-navy);
    background: var(--color-teal-soft);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.85rem;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .sector-grid .sector { padding: var(--space-4); }
  .sector-grid .sector:hover { border-color: var(--color-teal); }

  .ind-cta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  @media (max-width: 820px) {
    .sector--lead.sector--lead { grid-template-columns: 1fr; gap: var(--space-2); }
    .sector-grid.sector-grid { grid-template-columns: 1fr; }
  }
</style>