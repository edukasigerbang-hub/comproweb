---
// Gerbang Edukasi — a GCS product page within the GCS corporate ecosystem.
// Brand hierarchy: GCS (corporate) → Products & Solutions → Gerbang Edukasi.
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { company } from '../data/company';
import { gerbangEdukasiProductLabel, GERBANG_EDUKASI_URL } from '../data/solutions';
import geProduct from '../assets/product-gcs.png';

const hasExternalUrl = GERBANG_EDUKASI_URL !== '[TO BE PROVIDED]';
---
<SiteLayout
  title="Gerbang Edukasi"
  description="Gerbang Edukasi is interactive learning media for modern education — a product / solution developed by PT. Gerbang Cipta Sarana."
  currentPath="/gerbang-edukasi"
>
  <PageHero
    title="Gerbang Edukasi"
    subtitle="Interactive learning media for modern education."
    breadcrumb="Gerbang Edukasi"
  />

  <div class="container">
    {/* Product attribution to GCS — critical brand relationship */}
    <div class="product-label">
      <span class="pill">{gerbangEdukasiProductLabel}</span>
      <p class="product-label__text">
        Developed / provided by {company.name}.
      </p>
    </div>

    {/* Product Overview */}
    <section class="section">
      <SectionHeader
        eyebrow="Product Overview"
        title="Interactive Learning Media"
        lead="Gerbang Edukasi is an interactive learning application designed for education and interactive flat panels."
      />
      <p>
        As part of GCS's education and interactive multimedia solutions, Gerbang
        Edukasi brings interactive learning media to modern classrooms and learning
        environments.
      </p>
      <Image
        src={geProduct}
        alt="Perangkat interactive flat panel Gerbang Edukasi dengan antarmuka perangkat lunak pembelajaran di ruang kelas modern"
        widths={[480, 720, 960]}
        sizes="(max-width: 820px) 92vw, (max-width: 1200px) 60vw, 800px"
        loading="lazy"
        class="showcase-img"
      />
    </section>

    {/* Key capabilities */}
    <section class="section section--soft">
      <SectionHeader
        eyebrow="Key Capabilities"
        title="Capabilities"
        lead="Detailed capability information is available upon request."
      />
      <p class="ge-note">
        Gerbang Edukasi is designed around interactive learning for classrooms
        and Interactive Flat Panel (IFP) platforms.
      </p>
    </section>

    {/* Educational use case */}
    <section class="section">
      <SectionHeader
        eyebrow="Use Case"
        title="Built for Education"
        lead="Interactive learning media for modern classrooms and Interactive Flat Panel platforms."
      />
    </section>

    {/* CTA */}
    <section class="section section--soft">
      <div class="cta-inner">
        <h2>Explore Gerbang Edukasi</h2>
        {
          hasExternalUrl ? (
            <>
              <p>Visit the Gerbang Edukasi product site.</p>
              <a class="btn btn--primary" href={GERBANG_EDUKASI_URL} target="_blank" rel="noopener">
                Visit Gerbang Edukasi
              </a>
            </>
          ) : (
            <p class="ge-note">
              The Gerbang Edukasi product website is being prepared. For more
              information in the meantime, please <a href="/contact">contact GCS</a>.
            </p>
          )
        }
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .product-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .pil {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-orange);
    background: rgba(240, 122, 46, 0.12);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }
  .product-label__text { margin: 0; font-weight: 600; }

  .ge-note {
    color: var(--color-muted);
    background: rgba(27, 95, 180, 0.06);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .showcase-img {
    width: 100%;
    height: auto;
    display: block;
    margin-top: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .cta-inner { text-align: center; padding-block: var(--space-2); }
  .cta-inner p { color: var(--color-muted); }
</style>