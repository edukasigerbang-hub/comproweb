---
// Solutions — GCS products & solutions, with Gerbang Edukasi as a product.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { company } from '../data/company';
import { solutions, gerbangEdukasiProductLabel } from '../data/solutions';
---
<SiteLayout
  title="Solutions"
  description="GCS products and solutions: Information Systems, Education Solutions, Interactive Multimedia, Gerbang Edukasi, and Other Solutions."
  currentPath="/solutions"
>
  <PageHero
    title="Solutions"
    subtitle="Information systems, education solutions, interactive multimedia, and more."
    breadcrumb="Solutions"
  />

  <div class="container">
    <section class="section">
      <SectionHeader
        eyebrow="Products & Solutions"
        title="What GCS Provides"
        lead={`Products and solutions under the ${company.name} ecosystem.`}
      />
      <div class="grid">
        {
          solutions.map((s) => (
            <article class={'card' + (s.product ? ' card--product' : '')} key={s.id}>
              {s.product && <p class="pill">{gerbangEdukasiProductLabel}</p>}
              <h2 class="card__title">{s.name}</h2>
              <p class="card__body">{s.description}</p>
              <a class="card__link" href={s.route}>
                {s.product ? 'Explore Gerbang Edukasi' : s.name}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--soft" id="other-solutions-note">
      <SectionHeader eyebrow="Note" title="Tailored Solutions" lead="[CONTENT TO BE PROVIDED]" />
      <p>
        {company.shortName} develops technology solutions according to each
        organization's needs. Contact us to discuss your requirements.
      </p>
      <a class="btn btn--primary" href="/contact">Contact GCS</a>
    </section>
  </div>
</SiteLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card--product {
    border: 1px solid rgba(240, 122, 46, 0.5);
    background: linear-gradient(180deg, #fff 0%, #fff7f0 100%);
  }
  .card__title { font-size: 1.2rem; margin-bottom: var(--space-1); }
  .card__body { color: var(--color-muted); margin: 0 0 var(--space-2); }
  .card__link { font-weight: 600; margin-top: auto; }

  .pill {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-orange);
    background: rgba(240, 122, 46, 0.12);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  @media (max-width: 820px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>