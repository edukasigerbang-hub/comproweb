---
// Solutions — solution architecture connecting GCS capabilities to categories and products.
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import { company } from '../data/company';
import {
  solutions,
  gerbangEdukasiProductLabel,
  GERBANG_EDUKASI_URL,
} from '../data/solutions';
import geProduct from '../assets/product-gcs.png';

import { lp, type Lang } from '../i18n/config';
interface Props { lang?: Lang }
const { lang = 'id' } = Astro.props;
const en = lang === 'id' ? false : true;
const hasExternalGeUrl = GERBANG_EDUKASI_URL !== '[TO BE PROVIDED]';
const standard = solutions.filter((s) => !s.product);
const product = solutions.find((s) => s.product);

const t = en
  ? {
      metaTitle: 'Technology Solutions | PT. Gerbang Cipta Sarana',
      metaDesc: 'Explore GCS solutions — information systems, education solutions, interactive multimedia, and Gerbang Edukasi for modern classrooms.',
      heroEyebrow: 'Products & Solutions',
      heroTitle: 'From Capabilities to Working Solutions',
      heroSubtitle: `GCS turns its capability system into solutions for organizational needs — under the ${company.name} ecosystem.`,
      breadcrumb: 'Solutions',
      archEyebrow: 'Solution Architecture',
      archTitle: 'Solution Categories',
      archLead: 'Categories built on the same delivery methodology — combined according to your needs.',
      learnMore: 'Learn more',
      geText: 'Developed within GCS\'s education and interactive multimedia capabilities — interactive learning media designed for classrooms and Interactive Flat Panel platforms.',
      geCta: 'View Gerbang Edukasi',
      geImgAlt: 'Gerbang Edukasi interactive flat panel device with an interactive learning interface',
      ctaTitle: 'Don\'t see an exact fit?',
      ctaText: 'GCS develops technology solutions according to each organization\'s needs.',
      ctaButton: 'Contact GCS',
    }
  : {
      metaTitle: 'Solusi Teknologi | PT. Gerbang Cipta Sarana',
      metaDesc: 'Jelajahi solusi GCS — sistem informasi, solusi pendidikan, multimedia interaktif, serta Gerbang Edukasi untuk kelas modern.',
      heroEyebrow: 'Produk & Solusi',
      heroTitle: 'Dari Kapabilitas Menjadi Solusi Nyata',
      heroSubtitle: `GCS mengubah sistem kapabilitasnya menjadi solusi untuk kebutuhan organisasi — dalam ekosistem ${company.name}.`,
      breadcrumb: 'Solusi',
      archEyebrow: 'Arsitektur Solusi',
      archTitle: 'Kategori Solusi',
      archLead: 'Kategori yang dibangun atas metodologi pengiriman yang sama — dikombinasikan sesuai kebutuhan Anda.',
      learnMore: 'Pelajari selengkapnya',
      geText: 'Dikembangkan dari kapabilitas pendidikan dan multimedia interaktif GCS — media pembelajaran interaktif yang dirancang untuk kelas dan platform Interactive Flat Panel.',
      geCta: 'Lihat Gerbang Edukasi',
      geImgAlt: 'Perangkat interactive flat panel Gerbang Edukasi dengan antarmuka pembelajaran interaktif',
      ctaTitle: 'Tidak menemukan yang tepat?',
      ctaText: 'GCS mengembangkan solusi teknologi sesuai kebutuhan masing-masing organisasi.',
      ctaButton: 'Hubungi GCS',
    };
---
<SiteLayout
  title={t.metaTitle}
  description={t.metaDesc}
  lang={lang}
    currentPath={lp(lang, '/solutions')}
  ogImage="/og/og-gerbang-edukasi.jpg"
>
  <PageHero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    breadcrumb={t.breadcrumb}
  />

  {/* Solution categories */}
  <section class="section" aria-labelledby="cats-title">
    <div class="container">
      <SectionHeader
        eyebrow={t.archEyebrow}
        title={t.archTitle}
        lead={t.archLead}
      />
      <div class="cat-grid">
        {
          standard.map((s, i) => (
            <article class="cat" id={s.id} key={s.id}>
              <span class="cat__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="cat__title">{en && s.nameEn ? s.nameEn : s.name}</h3>
              <p class="cat__desc">{en && s.descriptionEn ? s.descriptionEn : s.description}</p>
              <a class="link" href={lp(lang, s.route)}>{t.learnMore}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Flagship product — highlighted but subordinate to GCS */}
  {
    product && (
      <section class="section section--soft" aria-labelledby="ge-sol-title">
        <div class="container ge-sol">
          <div class="ge-sol__content">
            <Badge variant="orange" label={gerbangEdukasiProductLabel} />
            <h2 id="ge-sol-title">Gerbang Edukasi</h2>
            <p class="ge-sol__lead">{en && product.descriptionEn ? product.descriptionEn : product.description}</p>
            <p class="ge-sol__text">{t.geText}</p>
            <Button variant="accent" href={hasExternalGeUrl ? GERBANG_EDUKASI_URL : lp(lang, product.route)}>
              {t.geCta}
            </Button>
          </div>
          <div class="ge-sol__visual">
            <Image
              src={geProduct}
              alt={t.geImgAlt}
              widths={[480, 720]}
              sizes="(max-width: 820px) 92vw, 44vw"
              loading="lazy"
              class="ge-sol__img"
            />
          </div>
        </div>
      </section>
    )
  }

  {/* CTA */}
  <section class="section">
    <div class="container sol-cta">
      <h2>{t.ctaTitle}</h2>
      <p>{t.ctaText}</p>
      <Button variant="primary" href={lp(lang, '/contact')}>{t.ctaButton}</Button>
    </div>
  </section>
</SiteLayout>

<style>
  .cat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .cat {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .cat:hover { border-color: var(--color-blue); box-shadow: var(--shadow-sm); }
  .cat__num { font-family: var(--font-heading); font-weight: 800; font-size: 0.9rem; color: var(--color-blue); }
  .cat__title { font-size: var(--font-h4); margin: var(--space-1) 0 0.25rem; }
  .cat__desc { color: var(--color-muted); margin: 0 0 var(--space-2); flex-grow: 1; }

  .ge-sol {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }
  .ge-sol__content h2 { font-size: var(--font-h1); margin: var(--space-2) 0; }
  .ge-sol__lead { font-size: var(--font-body-lg); font-weight: 600; color: var(--color-navy); }
  .ge-sol__text { color: var(--color-muted); max-width: 52ch; }
  .ge-sol__content :global(.btn) { margin-top: var(--space-2); }
  .ge-sol__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .sol-cta { text-align: center; max-width: var(--container-narrow); }
  .sol-cta h2 { font-size: var(--font-h2); }
  .sol-cta p { color: var(--color-muted); }
  .sol-cta :global(.btn) { margin-top: var(--space-2); }

  @media (max-width: 820px) {
    .cat-grid.cat-grid { grid-template-columns: 1fr; }
    .ge-sol.ge-sol { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>