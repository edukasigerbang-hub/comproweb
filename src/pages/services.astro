---
// Services — capability system: what GCS can actually do.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { services } from '../data/services';

const capabilityDetails: Record<'id' | 'en', Record<string, string[]>> = {
  id: {
    'it-consulting': ['Perencanaan', 'Implementasi', 'Evaluasi', 'Konsultansi terkait TI'],
    'software-development': ['Sistem informasi', 'Solusi perangkat lunak', 'Pengembangan sistem'],
    'business-process-management': ['Analisis proses', 'Pengelolaan proses', 'Efisiensi bisnis'],
    'training': ['Program pelatihan', 'Pengembangan profesional', 'Transfer pengetahuan'],
    'interactive-multimedia': ['Konten interaktif', 'Presentasi interaktif', 'Solusi multimedia'],
    'educational-media': ['Media pembelajaran', 'Konten pendidikan', 'Teknologi berorientasi pendidikan'],
  },
  en: {
    'it-consulting': ['Planning', 'Implementation', 'Evaluation', 'IT-related consulting'],
    'software-development': ['Information systems', 'Software solutions', 'System development'],
    'business-process-management': ['Process analysis', 'Process management', 'Business efficiency'],
    'training': ['Training programs', 'Professional development', 'Knowledge transfer'],
    'interactive-multimedia': ['Interactive content', 'Interactive presentation', 'Multimedia solutions'],
    'educational-media': ['Learning media', 'Educational content', 'Education-oriented technology'],
  },
};

import { lp, type Lang } from '../i18n/config';
interface Props { lang?: Lang }
const { lang = 'id' } = Astro.props;
const en = lang === 'id' ? false : true;

const t = en
  ? {
      metaTitle: 'Technology Services & Capabilities | GCS',
      metaDesc: 'GCS capabilities: IT consulting, software development, business process management, training, interactive multimedia, and educational media.',
      heroEyebrow: 'Services',
      heroTitle: 'Capabilities That Deliver',
      heroSubtitle: 'Six capability areas covering the full lifecycle of technology — from planning and development to training and educational media.',
      breadcrumb: 'Services',
      introHeading: 'Capability Overview',
      introText: 'Every engagement draws on the same system of capabilities. Depending on your organization\'s needs, these areas are combined into a single coherent solution.',
      seeSolutions: 'See Solutions',
      contactUs: 'Contact Us',
      listAria: 'Capability list',
      ctaTitle: 'Need a specific combination?',
      ctaText: 'Solutions are developed according to each organization\'s needs.',
      ctaButton: 'Discuss Your Needs',
    }
  : {
      metaTitle: 'Layanan & Kapabilitas Teknologi | GCS',
      metaDesc: 'Kapabilitas GCS: konsultasi TI, pengembangan perangkat lunak, manajemen proses bisnis, pelatihan, multimedia interaktif, dan media pendidikan.',
      heroEyebrow: 'Layanan',
      heroTitle: 'Kapabilitas yang Memberikan Hasil',
      heroSubtitle: 'Enam area kapabilitas yang mencakup siklus teknologi secara utuh — dari perencanaan dan pengembangan hingga pelatihan dan media pendidikan.',
      breadcrumb: 'Layanan',
      introHeading: 'Ikhtisar Kapabilitas',
      introText: 'Setiap kolaborasi bersandar pada sistem kapabilitas yang sama. Sesuai kebutuhan organisasi Anda, area-area ini dikombinasikan menjadi satu solusi yang utuh.',
      seeSolutions: 'Lihat Solusi',
      contactUs: 'Hubungi Kami',
      listAria: 'Daftar kapabilitas',
      ctaTitle: 'Butuh kombinasi yang spesifik?',
      ctaText: 'Solusi dikembangkan sesuai kebutuhan masing-masing organisasi.',
      ctaButton: 'Diskusikan Kebutuhan Anda',
    };
---
<SiteLayout
  title={t.metaTitle}
  description={t.metaDesc}
  lang={lang}
  currentPath={lp(lang, '/services')}
>
  <PageHero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    breadcrumb={t.breadcrumb}
  />

  <section class="section" aria-labelledby="svc-intro">
    <div class="container svc-intro">
      <h2 id="svc-intro" class="visually-hidden">{t.introHeading}</h2>
      <p class="svc-intro__text">{t.introText}</p>
      <div class="svc-intro__links">
        <Button variant="secondary" size="sm" href={lp(lang, '/solutions')}>{t.seeSolutions}</Button>
        <Button variant="ghost" size="sm" href={lp(lang, '/contact')}>{t.contactUs}</Button>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label={t.listAria}>
    <div class="container">
      <ol class="caps">
        {
          services.map((s, i) => (
            <li class="cap-row" key={s.id}>
              <span class="cap-row__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="cap-row__body">
                <div class="cap-row__head">
                  <h2 class="cap-row__title">{en && s.nameEn ? s.nameEn : s.name}</h2>
                  <p class="cap-row__desc">{en && s.shortDescriptionEn ? s.shortDescriptionEn : s.shortDescription}</p>
                </div>
                {capabilityDetails[lang][s.id] && (
                  <ul class="cap-row__details">
                    {capabilityDetails[lang][s.id].map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container cta-band">
      <div>
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaText}</p>
      </div>
      <Button variant="primary" href={lp(lang, '/contact')}>{t.ctaButton}</Button>
    </div>
  </section>
</SiteLayout>

<style>
  .svc-intro {
    max-width: var(--container-narrow);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
  }
  .svc-intro__text {
    margin: 0;
    font-size: var(--font-body-lg);
    color: var(--color-muted);
    max-width: 52ch;
  }
  .svc-intro__links { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  /* Numbered editorial rows */
  .caps { list-style: none; margin: 0; padding: 0; counter-reset: cap; }
  .cap-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }
  .cap-row:last-child { border-bottom: 1px solid var(--color-border); }
  .cap-row__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--color-teal);
    line-height: 1.2;
  }
  .cap-row__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-4);
  }
  .cap-row__title { font-size: var(--font-h3); margin: 0 0 var(--space-1); }
  .cap-row__desc { color: var(--color-muted); margin: 0; max-width: 46ch; }
  .cap-row__details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .cap-row__details li {
    position: relative;
    padding-left: var(--space-3);
    color: var(--color-text);
    font-size: var(--font-body-sm);
  }
  .cap-row__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 2px;
    background: var(--color-orange);
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }
  .cta-band h2 { margin-bottom: 0.25rem; font-size: var(--font-h3); }
  .cta-band p { margin: 0; color: var(--color-muted); }

  @media (max-width: 820px) {
    .cap-row.cap-row { grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-3); }
    .cap-row__num { font-size: 1.15rem; }
    .cap-row__body.cap-row__body { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>