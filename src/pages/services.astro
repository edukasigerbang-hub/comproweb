---
// Services — capability system: what GCS can actually do.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { services } from '../data/services';

const capabilityDetails: Record<string, string[]> = {
  'it-consulting': ['Planning', 'Implementation', 'Evaluation', 'IT-related consulting'],
  'software-development': ['Information systems', 'Software solutions', 'System development'],
  'business-process-management': ['Process analysis', 'Process management', 'Business efficiency'],
  'training': ['Training programs', 'Professional development', 'Knowledge transfer'],
  'interactive-multimedia': ['Interactive content', 'Interactive presentation', 'Multimedia solutions'],
  'educational-media': ['Learning media', 'Educational content', 'Education-oriented technology'],
};
---
<SiteLayout
  title="Technology Services & Capabilities | GCS"
  description={`GCS capabilities: IT consulting, software development, business process management, training, interactive multimedia, and educational media.`}
  currentPath="/services"
>
  <PageHero
    eyebrow="Services"
    title="Capabilities That Deliver"
    subtitle="Six capability areas covering the full lifecycle of technology — from planning and development to training and educational media."
    breadcrumb="Services"
  />

  <section class="section" aria-labelledby="svc-intro">
    <div class="container svc-intro">
      <h2 id="svc-intro" class="visually-hidden">Capability Overview</h2>
      <p class="svc-intro__text">
        Every engagement draws on the same system of capabilities. Depending on
        your organization's needs, these areas are combined into a single
        coherent solution.
      </p>
      <div class="svc-intro__links">
        <Button variant="secondary" size="sm" href="/solutions">See Solutions</Button>
        <Button variant="ghost" size="sm" href="/contact">Contact Us</Button>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label="Capability list">
    <div class="container">
      <ol class="caps">
        {
          services.map((s, i) => (
            <li class="cap-row" key={s.id}>
              <span class="cap-row__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="cap-row__body">
                <div class="cap-row__head">
                  <h2 class="cap-row__title">{s.name}</h2>
                  <p class="cap-row__desc">{s.shortDescription}</p>
                </div>
                {capabilityDetails[s.id] && (
                  <ul class="cap-row__details">
                    {capabilityDetails[s.id].map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container cta-band">
      <div>
        <h2>Need a specific combination?</h2>
        <p>Solutions are developed according to each organization's needs.</p>
      </div>
      <Button variant="primary" href="/contact">Discuss Your Needs</Button>
    </div>
  </section>
</SiteLayout>

<style>
  .svc-intro {
    max-width: var(--container-narrow);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
  }
  .svc-intro__text {
    margin: 0;
    font-size: var(--font-body-lg);
    color: var(--color-muted);
    max-width: 52ch;
  }
  .svc-intro__links { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  /* Numbered editorial rows */
  .caps { list-style: none; margin: 0; padding: 0; counter-reset: cap; }
  .cap-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }
  .cap-row:last-child { border-bottom: 1px solid var(--color-border); }
  .cap-row__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--color-teal);
    line-height: 1.2;
  }
  .cap-row__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-4);
  }
  .cap-row__title { font-size: var(--font-h3); margin: 0 0 var(--space-1); }
  .cap-row__desc { color: var(--color-muted); margin: 0; max-width: 46ch; }
  .cap-row__details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .cap-row__details li {
    position: relative;
    padding-left: var(--space-3);
    color: var(--color-text);
    font-size: var(--font-body-sm);
  }
  .cap-row__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 2px;
    background: var(--color-orange);
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }
  .cta-band h2 { margin-bottom: 0.25rem; font-size: var(--font-h3); }
  .cta-band p { margin: 0; color: var(--color-muted); }

  @media (max-width: 820px) {
    .cap-row.cap-row { grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-3); }
    .cap-row__num { font-size: 1.15rem; }
    .cap-row__body.cap-row__body { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>