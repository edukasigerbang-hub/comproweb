---
// Contact — lead-generation structure + clearly marked placeholder contact info.
// Form fields are structured but not wired to any fake email/service.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { company } from '../data/company';
import { contact, contactFormFields } from '../data/contact';
import { services } from '../data/services';
---
<SiteLayout
  title="Contact"
  description="Contact PT. Gerbang Cipta Sarana to discuss your technology needs."
  currentPath="/contact"
>
  <PageHero
    title="Contact"
    subtitle="Discuss your technology needs with GCS."
    breadcrumb="Contact"
  />

  <div class="container">
    <div class="contact-layout">
      <section class="section">
        <SectionHeader eyebrow="Get in Touch" title="Send an Inquiry" />
        <p>
          Tell us about your organization and how GCS can help. This form is a
          structural template; submission handling will be connected once the
          contact service is configured.
        </p>

        <form class="form" method="post" name="contact">
          <div class="form__grid">
            <div class="form__field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="form__field">
              <label for="organization">Organization</label>
              <input id="organization" name="organization" type="text" autocomplete="organization" />
            </div>
            <div class="form__field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="form__field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="form__field">
              <label for="interest">Service / Interest</label>
              <select id="interest" name="interest">
                <option value="">Select a service area</option>
                {services.map((s) => <option value={s.id}>{s.name}</option>)}
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form__field form__field--full">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5"></textarea>
            </div>
          </div>
          <button class="btn btn--primary" type="submit">Submit Inquiry</button>
        </form>
      </section>

      <aside class="section contact-info">
        <SectionHeader eyebrow="Company" title="Contact Details" />
        <p class="contact-line"><strong>Address:</strong> {contact.address}</p>
        <p class="contact-line"><strong>Phone:</strong> {contact.phone}</p>
        <p class="contact-line"><strong>Email:</strong> {contact.email}</p>
        <p class="contact-line"><strong>Social Media:</strong> {contact.socialMedia}</p>
        <p class="contact-line contact-line--muted">
          {company.name} — {company.tagline}
        </p>
      </aside>
    </div>
  </div>
</SiteLayout>

<style>
  .contact-layout { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); }

  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-bottom: var(--space-2); }
  .form__field--full { grid-column: 1 / -1; }
  .form__field label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem; }
  .form__field input,
  .form__field select,
  .form__field textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    background: #fff;
    color: var(--color-text);
  }
  .form__field input:focus,
  .form__field select:focus,
  .form__field textarea:focus {
    outline: none;
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(27, 95, 180, 0.15);
  }

  .contact-info { background: var(--color-bg-soft); border-radius: var(--radius); padding: var(--space-4); align-self: start; }
  .contact-line { margin-bottom: var(--space-2); }
  .contact-line--muted { color: var(--color-muted); font-style: italic; }

  @media (max-width: 820px) { .contact-layout { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .form__grid { grid-template-columns: 1fr; } }
</style>