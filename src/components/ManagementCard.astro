---
// Management card — name + position (no fabricated photos/biographies).
interface Props {
  name: string;
  position: string;
}

const { name, position } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---

<article class="card management-card">
  <span class="management-card__avatar" aria-hidden="true">{initial}</span>
  <h3 class="management-card__name">{name}</h3>
  <p class="management-card__role">{position}</p>
</article>

<style>
  .management-card { text-align: center; }
  .management-card__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-navy);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }
  .management-card__name { font-size: var(--font-h4); margin-bottom: 0.25rem; }
  .management-card__role { color: var(--color-teal); font-weight: 600; margin: 0; }
</style>