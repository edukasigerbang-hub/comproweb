---
// ErrorState — reusable bilingual error experience for GCS.
// Renders a premium, calm corporate error composition inside SiteLayout's <main>.
// Zero client frameworks; one tiny inline script in 404.astro handles EN inference
// for unmatched routes (static-hosting limitation documented in the phase report).
interface Props {
  /** Error code, e.g. '404' or '500'. Displayed as oversized typography. */
  code: string;
  lang?: 'id' | 'en';
  eyebrow: string;
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tertiaryLabel?: string;
  tertiaryHref?: string;
}
const {
  code,
  lang = 'id',
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tertiaryLabel,
  tertiaryHref,
} = Astro.props;
---
<section class="err" data-error-root>
  <div class="container err__inner">
    {/* Abstract geometric visual — connected nodes on an architectural grid */}
    <div class="err__visual" aria-hidden="true">
      <svg viewBox="0 0 520 300" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs>
        <linearGradient id="err-line" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#14919b" stop-opacity="0.55" />
          <stop offset="100%" stop-color="#f07a2e" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      {/* architectural grid */}
      <g stroke="#14304d" stroke-opacity="0.08">
        {Array.from({ length: 9 }).map((_, i) => (
          <line x1={i * 60} y1="0" x2={i * 60} y2="360" stroke-width="1" />
        ))}
        {Array.from({ length: 7 }).map((_, i) => (
          <line x1="0" y1={i * 60} x2="520" y2={i * 60} stroke-width="1" />
        ))}
      </g>
      {/* navigation path with a break — "route unavailable" */}
      <path d="M20 300 L150 300 L210 220 L330 220" stroke="url(#err-line)" stroke-width="2.5" stroke-linecap="round" />
      <path d="M390 220 L480 130" stroke="#14304d" stroke-opacity="0.18" stroke-width="2.5"
            stroke-linecap="round" stroke-dasharray="2 10" />
      {/* nodes */}
      <circle cx="20" cy="300" r="6" fill="#14919b" />
      <circle cx="210" cy="220" r="6" fill="#14919b" />
      <circle cx="330" cy="220" r="9" fill="#fff" stroke="#f07a2e" stroke-width="3" />
      <circle cx="480" cy="130" r="5" fill="#14304d" fill-opacity="0.25" />
      {/* subtle accent square */}
      <rect x="392" y="52" width="56" height="56" rx="12" fill="#14919b" fill-opacity="0.08" />
      <rect x="60" y="60" width="34" height="34" rx="8" fill="#f07a2e" fill-opacity="0.10" />
      </svg>
    </div>

    <div class="err__content">
      <p class="err__eyebrow">{code} · {eyebrow}</p>
      <p class="err__code" aria-hidden="true">{code}</p>
      <h1 class="err__title">{title}</h1>
      <p class="err__desc">{description}</p>
      <div class="err__actions">
        <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
        {secondaryLabel && secondaryHref && (
          <a class="btn btn--secondary" href={secondaryHref}>{secondaryLabel}</a>
        )}
        {tertiaryLabel && tertiaryHref && (
          <a class="btn btn--outline" href={tertiaryHref}>{tertiaryLabel}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .err__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }
  .err { min-height: 60vh; }
  .err__content { max-width: 56ch; position: relative; }
  .err__eyebrow {
    font-size: var(--font-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
    margin-bottom: var(--space-2);
  }
  /* Ghost code — decorative, tucked behind the title on desktop only */
  .err__code {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(5rem, 16vw, 11rem);
    line-height: 0.9;
    color: var(--color-navy);
    opacity: 0.06;
    margin: 0 0 calc(-1 * var(--space-5));
    user-select: none;
    pointer-events: none;
  }
  .err__title {
    font-size: var(--font-h1);
    color: var(--color-navy);
    margin-bottom: var(--space-2);
    position: relative;
  }
  .err__desc { color: var(--color-muted); font-size: var(--font-body-lg); max-width: 48ch; }
  .err__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .err__visual svg { width: 100%; height: auto; display: block; }

  @media (max-width: 900px) {
    .err.err { min-height: auto; }
    .err__inner.err__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
    }
    /* Mobile order: eyebrow → heading → copy → CTA → visual */
    .err__visual { order: 2; max-width: 340px; margin-inline: auto; }

    /* Ghost code: compact badge-style numeral instead of a huge watermark */
    .err__code {
      font-size: clamp(3.2rem, 18vw, 4.5rem);
      opacity: 0.10;
      margin-bottom: calc(-1 * var(--space-3));
    }
    .err__title { font-size: clamp(1.55rem, 6.4vw, 2rem); }
    .err__desc { font-size: var(--font-body); }

    /* CTA: clean stacked hierarchy, guaranteed to fit any narrow viewport */
    .err__inner > * { min-width: 0; }
    .err__actions { display: block; }
    .err__actions :global(.btn) {
      display: block;
      width: 100%;
      text-align: center;
      margin: 0 0 var(--space-2);
    }
    .err__actions :global(.btn:last-child) { margin-bottom: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .err__visual svg path:first-of-type { animation: err-draw 1.2s ease-out both; }
    @keyframes err-draw { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
  }
</style>