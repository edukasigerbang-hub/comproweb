---
// Experience card — project + client + sector badge.
import Badge from './Badge.astro';

interface Props {
  project: string;
  client: string;
  sector: string;
}

const { project, client, sector } = Astro.props;
---

<article class="card experience-card">
  <div class="experience-card__head">
    <h3 class="experience-card__title">{project}</h3>
    <Badge variant="teal" label={sector} />
  </div>
  <p class="experience-card__client"><strong>Client / User:</strong> {client}</p>
</article>

<style>
  .experience-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .experience-card__title { font-size: var(--font-h4); margin: 0 0 var(--space-1); }
  .experience-card__client { color: var(--color-muted); margin: 0; }
</style>