---
// GCS Footer — reinforces GCS as the parent identity and Gerbang Edukasi as a product.
import { company } from '../data/company';
import { footerNavigation } from '../data/navigation';
import { contact } from '../data/contact';

// Only show confirmed contact details publicly — placeholders stay in the data layer.
const contactDetails = [contact.address, contact.phone, contact.email, contact.socialMedia]
  .filter((v) => v && !v.includes('['));
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/" aria-label={company.name + ' — Beranda'}>
        <span class="site-footer__mark">
          <img src="/favicon-192.png" alt="" width="34" height="34" loading="lazy" />
        </span>
        <span class="site-footer__identity">
          <span class="site-footer__name">{company.name}</span>
          <span class="site-footer__tagline">{company.tagline}</span>
        </span>
      </a>
      <p class="site-footer__blurb">
        A multidisciplinary technology consulting and solutions company with
        experience across education, government, and private-sector projects.
      </p>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Company</h3>
      <ul class="site-footer__list">
        {footerNavigation.company.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Solutions</h3>
      <ul class="site-footer__list">
        {footerNavigation.solutions.map((item) => (
          <li class="site-footer__solution-item">
            <a href={item.href}>{item.label}</a>
            {item.label === 'Gerbang Edukasi' && <span class="site-footer__product-tag">A GCS Product / Solution</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Contact</h3>
      {
        contactDetails.length > 0 ? (
          <ul class="site-footer__list site-footer__contact">
            {contactDetails.map((line) => <li>{line}</li>)}
          </ul>
        ) : (
          <p class="site-footer__contact-note">Contact details are available upon request.</p>
        )
      }
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} {company.name}. All rights reserved.</p>
    <p class="site-footer__legal">
      <a href="/about#legalitas">Legalitas</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: var(--color-on-dark-muted);
    padding: var(--space-6) 0 var(--space-4);
    font-size: 0.95rem;
    border-top: 4px solid var(--color-teal);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1.2fr;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .site-footer__logo { display: inline-flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .site-footer__logo:hover { text-decoration: none; }
  .site-footer__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: #ffffff;
    overflow: hidden;
  }
  .site-footer__mark img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .site-footer__identity { display: flex; flex-direction: column; line-height: 1.2; }
  .site-footer__name { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; color: #fff; }
  .site-footer__tagline { font-size: 0.72rem; color: var(--color-on-dark-muted); letter-spacing: 0.06em; text-transform: uppercase; }

  .site-footer__blurb { color: var(--color-on-dark-muted); max-width: 34ch; }

  .site-footer__heading { color: #fff; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-3); }

  .site-footer__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer__contact-note { color: var(--color-on-dark-muted); margin: 0; }
  .site-footer__col .site-footer__list a { color: var(--color-on-dark-muted); }
  .site-footer__col .site-footer__list a:hover { color: #fff; text-decoration: none; }

  .site-footer__solution-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .site-footer__solution-item > a { color: #fff !important; font-weight: 600; }
  .site-footer__product-tag { font-size: 0.68rem; color: #8fd0d6; letter-spacing: 0.04em; }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: var(--space-3);
    font-size: 0.85rem;
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__legal a { color: var(--color-on-dark-muted); }
  .site-footer__legal a:hover { color: #fff; text-decoration: none; }

  @media (max-width: 900px) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; row-gap: var(--space-4); }
  }
  @media (max-width: 560px) {
    .site-footer__inner { grid-template-columns: 1fr; }
    .site-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>